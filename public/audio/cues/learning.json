 "lines": [
  {
   "text": "You already know how to learn.",
   "start": 1.329,
   "end": 3.229,
   "wordStart": 0,
   "wordEnd": 5
  },
  {
   "text": "You sit with a problem until it gives in.",
   "start": 3.889,
   "end": 6.309,
   "wordStart": 6,
   "wordEnd": 14
  },
  {
   "text": "Read every day.",
   "start": 7.15,
   "end": 8.25,
   "wordStart": 15,
   "wordEnd": 17
  },
  {
   "text": "Ideas are the cheapest leverage there is.",
   "start": 9.009,
   "end": 11.309,
   "wordStart": 18,
   "wordEnd": 24
  },
  {
   "text": "One book can reframe a decade.",
   "start": 12.149,
   "end": 14.21,
   "wordStart": 25,
   "wordEnd": 30
  },
  {
   "text": "Read outside your field.",
   "start": 15.25,
   "end": 16.75,
   "wordStart": 31,
   "wordEnd": 34
  },
  {
   "text": "The best engineers are curious about everything.",
   "start": 17.43,
   "end": 20.189,
   "wordStart": 35,
   "wordEnd": 41
  },
  {
   "text": "Write things down.",
   "start": 21.149,
   "end": 22.149,
   "wordStart": 42,
   "wordEnd": 44
  },
  {
   "text": "Teach what you learn.",
   "start": 22.889,
   "end": 24.269,
   "wordStart": 45,
   "wordEnd": 48
  },
  {
   "text": "Stay humble enough to be wrong.",
   "start": 25.269,
   "end": 26.902,
   "wordStart": 49,
   "wordEnd": 54
  }
