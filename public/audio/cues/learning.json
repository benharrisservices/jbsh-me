 "lines": [
  {
   "text": "You already know how to learn.",
   "start": 0.079,
   "end": 1.979,
   "wordStart": 0,
   "wordEnd": 5
  },
  {
   "text": "You sit with a problem until it gives in.",
   "start": 2.639,
   "end": 5.059,
   "wordStart": 6,
   "wordEnd": 14
  },
  {
   "text": "Read every day.",
   "start": 5.9,
   "end": 7.0,
   "wordStart": 15,
   "wordEnd": 17
  },
  {
   "text": "Ideas are the cheapest leverage there is.",
   "start": 7.759,
   "end": 10.059,
   "wordStart": 18,
   "wordEnd": 24
  },
  {
   "text": "One book can reframe a decade.",
   "start": 10.899,
   "end": 12.96,
   "wordStart": 25,
   "wordEnd": 30
  },
  {
   "text": "Read outside your field.",
   "start": 14.0,
   "end": 15.5,
   "wordStart": 31,
   "wordEnd": 34
  },
  {
   "text": "The best engineers are curious about everything.",
   "start": 16.18,
   "end": 18.939,
   "wordStart": 35,
   "wordEnd": 41
  },
  {
   "text": "Write things down.",
   "start": 19.899,
   "end": 20.899,
   "wordStart": 42,
   "wordEnd": 44
  },
  {
   "text": "Teach what you learn.",
   "start": 21.639,
   "end": 23.019,
   "wordStart": 45,
   "wordEnd": 48
  },
  {
   "text": "Stay humble enough to be wrong.",
   "start": 24.019,
   "end": 25.652,
   "wordStart": 49,
   "wordEnd": 54
  }
 ]
