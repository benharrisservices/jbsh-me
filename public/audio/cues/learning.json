 "lines": [
  {
   "text": "You already know how to learn.",
   "start": 0.579,
   "end": 2.479,
   "wordStart": 0,
   "wordEnd": 5
  },
  {
   "text": "You sit with a problem until it gives in.",
   "start": 3.139,
   "end": 5.559,
   "wordStart": 6,
   "wordEnd": 14
  },
  {
   "text": "Read every day.",
   "start": 6.4,
   "end": 7.5,
   "wordStart": 15,
   "wordEnd": 17
  },
  {
   "text": "Ideas are the cheapest leverage there is.",
   "start": 8.259,
   "end": 10.559,
   "wordStart": 18,
   "wordEnd": 24
  },
  {
   "text": "One book can reframe a decade.",
   "start": 11.399,
   "end": 13.46,
   "wordStart": 25,
   "wordEnd": 30
  },
  {
   "text": "Read outside your field.",
   "start": 14.5,
   "end": 16.0,
   "wordStart": 31,
   "wordEnd": 34
  },
  {
   "text": "The best engineers are curious about everything.",
   "start": 16.68,
   "end": 19.439,
   "wordStart": 35,
   "wordEnd": 41
  },
  {
   "text": "Write things down.",
   "start": 20.399,
   "end": 21.399,
   "wordStart": 42,
   "wordEnd": 44
  },
  {
   "text": "Teach what you learn.",
   "start": 22.139,
   "end": 23.519,
   "wordStart": 45,
   "wordEnd": 48
  },
  {
   "text": "Stay humble enough to be wrong.",
   "start": 24.519,
   "end": 26.152,
   "wordStart": 49,
   "wordEnd": 54
  }
