 "lines": [
  {
   "text": "James,",
   "start": 1.269,
   "end": 1.769,
   "wordStart": 0,
   "wordEnd": 0
  },
  {
   "text": "I put off writing this. Not because I had nothing to say. Because I wanted to get it right.",
   "start": 2.549,
   "end": 8.409,
   "wordStart": 1,
   "wordEnd": 19
  },
  {
   "text": "You are capable of more than where you are. I do not say that to cheer you on. I say it because I have watched you.",
   "start": 9.25,
   "end": 18.109,
   "wordStart": 20,
   "wordEnd": 45
  },
  {
   "text": "You do not need to become someone else. You need to become more of yourself.",
   "start": 18.949,
   "end": 24.489,
   "wordStart": 46,
   "wordEnd": 60
  },
  {
   "text": "You will get things wrong. I have. The mistakes that matter are the times you knew better and did nothing.",
   "start": 25.649,
   "end": 33.049,
   "wordStart": 61,
   "wordEnd": 80
  },
  {
   "text": "Stay curious. Stay kind. Answer the people who love you.",
   "start": 34.169,
   "end": 39.229,
   "wordStart": 81,
   "wordEnd": 90
  },
  {
   "text": "Time is the one thing you cannot earn back. Spend it like you mean it.",
   "start": 39.95,
   "end": 45.389,
   "wordStart": 91,
   "wordEnd": 105
  },
  {
   "text": "I built this because I believe in you. The real you. Not the tidy version.",
   "start": 46.45,
   "end": 52.809,
   "wordStart": 106,
   "wordEnd": 120
  },
  {
   "text": "Start.",
   "start": 54.049,
   "end": 54.489,
   "wordStart": 121,
   "wordEnd": 121
  },
  {
   "text": "Love,",
   "start": 55.669,
   "end": 56.509,
   "wordStart": 122,
   "wordEnd": 122
  },
  {
   "text": "Ben",
   "start": 56.569,
   "end": 56.949,
   "wordStart": 123,
   "wordEnd": 123
  },
  {
   "text": "Now close this tab.",
   "start": 58.09,
   "end": 59.27,
   "wordStart": 124,
   "wordEnd": 127
  },
  {
   "text": "Go build something.",
   "start": 60.169,
   "end": 61.253,
   "wordStart": 128,
   "wordEnd": 130
  }
 ],
