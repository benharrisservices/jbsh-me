 "lines": [
  {
   "text": "Money is stored freedom.",
   "start": 0.519,
   "end": 2.139,
   "wordStart": 0,
   "wordEnd": 3
  },
  {
   "text": "It is the ability to say no.",
   "start": 2.759,
   "end": 5.119,
   "wordStart": 4,
   "wordEnd": 10
  },
  {
   "text": "Spend less than you earn.",
   "start": 5.98,
   "end": 7.859,
   "wordStart": 11,
   "wordEnd": 15
  },
  {
   "text": "The gap is where freedom lives.",
   "start": 8.419,
   "end": 10.26,
   "wordStart": 16,
   "wordEnd": 21
  },
  {
   "text": "Debt is a quiet chain.",
   "start": 11.34,
   "end": 13.099,
   "wordStart": 22,
   "wordEnd": 26
  },
  {
   "text": "Build things that pay you back.",
   "start": 14.039,
   "end": 16.219,
   "wordStart": 27,
   "wordEnd": 32
  },
  {
   "text": "Looking wealthy and being wealthy are not the same.",
   "start": 17.159,
   "end": 20.659,
   "wordStart": 33,
   "wordEnd": 41
  },
  {
   "text": "One is loud.",
   "start": 21.479,
   "end": 22.299,
   "wordStart": 42,
   "wordEnd": 44
  },
  {
   "text": "The other is patient.",
   "start": 22.84,
   "end": 24.359,
   "wordStart": 45,
   "wordEnd": 48
  },
  {
   "text": "Respect money. Do not worship it.",
   "start": 25.279,
   "end": 28.294,
   "wordStart": 49,
   "wordEnd": 54
  }
 ],
