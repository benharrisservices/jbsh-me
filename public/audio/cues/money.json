 "lines": [
  {
   "text": "Money is stored freedom.",
   "start": 1.269,
   "end": 2.889,
   "wordStart": 0,
   "wordEnd": 3
  },
  {
   "text": "It is the ability to say no.",
   "start": 3.509,
   "end": 5.869,
   "wordStart": 4,
   "wordEnd": 10
  },
  {
   "text": "Spend less than you earn.",
   "start": 6.73,
   "end": 8.609,
   "wordStart": 11,
   "wordEnd": 15
  },
  {
   "text": "The gap is where freedom lives.",
   "start": 9.169,
   "end": 11.01,
   "wordStart": 16,
   "wordEnd": 21
  },
  {
   "text": "Debt is a quiet chain.",
   "start": 12.09,
   "end": 13.849,
   "wordStart": 22,
   "wordEnd": 26
  },
  {
   "text": "Build things that pay you back.",
   "start": 14.789,
   "end": 16.969,
   "wordStart": 27,
   "wordEnd": 32
  },
  {
   "text": "Looking wealthy and being wealthy are not the same.",
   "start": 17.909,
   "end": 21.409,
   "wordStart": 33,
   "wordEnd": 41
  },
  {
   "text": "One is loud.",
   "start": 22.229,
   "end": 23.049,
   "wordStart": 42,
   "wordEnd": 44
  },
  {
   "text": "The other is patient.",
   "start": 23.59,
   "end": 25.109,
   "wordStart": 45,
   "wordEnd": 48
  },
  {
   "text": "Respect money. Do not worship it.",
   "start": 26.029,
   "end": 29.044,
   "wordStart": 49,
   "wordEnd": 54
  }
