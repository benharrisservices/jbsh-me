 "lines": [
  {
   "text": "Money is stored freedom.",
   "start": 0.019,
   "end": 1.639,
   "wordStart": 0,
   "wordEnd": 3
  },
  {
   "text": "It is the ability to say no.",
   "start": 2.259,
   "end": 4.619,
   "wordStart": 4,
   "wordEnd": 10
  },
  {
   "text": "Spend less than you earn.",
   "start": 5.48,
   "end": 7.359,
   "wordStart": 11,
   "wordEnd": 15
  },
  {
   "text": "The gap is where freedom lives.",
   "start": 7.919,
   "end": 9.76,
   "wordStart": 16,
   "wordEnd": 21
  },
  {
   "text": "Debt is a quiet chain.",
   "start": 10.84,
   "end": 12.599,
   "wordStart": 22,
   "wordEnd": 26
  },
  {
   "text": "Build things that pay you back.",
   "start": 13.539,
   "end": 15.719,
   "wordStart": 27,
   "wordEnd": 32
  },
  {
   "text": "Looking wealthy and being wealthy are not the same.",
   "start": 16.659,
   "end": 20.159,
   "wordStart": 33,
   "wordEnd": 41
  },
  {
   "text": "One is loud.",
   "start": 20.979,
   "end": 21.799,
   "wordStart": 42,
   "wordEnd": 44
  },
  {
   "text": "The other is patient.",
   "start": 22.34,
   "end": 23.859,
   "wordStart": 45,
   "wordEnd": 48
  },
  {
   "text": "Respect money. Do not worship it.",
   "start": 24.779,
   "end": 27.794,
   "wordStart": 49,
   "wordEnd": 54
  }
 ]
