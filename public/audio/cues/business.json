 "lines": [
  {
   "text": "You understand infrastructure.",
   "start": 0.079,
   "end": 2.119,
   "wordStart": 0,
   "wordEnd": 2
  },
  {
   "text": "That is worth more than you think.",
   "start": 2.919,
   "end": 4.619,
   "wordStart": 3,
   "wordEnd": 9
  },
  {
   "text": "The gap between idea and built has closed.",
   "start": 5.48,
   "end": 8.699,
   "wordStart": 10,
   "wordEnd": 17
  },
  {
   "text": "You do not have to quit tomorrow.",
   "start": 9.719,
   "end": 11.34,
   "wordStart": 18,
   "wordEnd": 24
  },
  {
   "text": "Start something small on the side.",
   "start": 12.039,
   "end": 14.0,
   "wordStart": 25,
   "wordEnd": 30
  },
  {
   "text": "A tool. A service. A name people trust.",
   "start": 14.659,
   "end": 18.639,
   "wordStart": 31,
   "wordEnd": 38
  },
  {
   "text": "Ownership is the goal.",
   "start": 19.699,
   "end": 21.219,
   "wordStart": 39,
   "wordEnd": 42
  },
  {
   "text": "Not employment.",
   "start": 21.699,
   "end": 22.68,
   "wordStart": 43,
   "wordEnd": 44
  },
  {
   "text": "Build something that works when you leave the room.",
   "start": 23.519,
   "end": 26.059,
   "wordStart": 45,
   "wordEnd": 53
  },
  {
   "text": "That is the beginning of a plan.",
   "start": 26.92,
   "end": 28.682,
   "wordStart": 54,
   "wordEnd": 60
  }
