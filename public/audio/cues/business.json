 "lines": [
  {
   "text": "You understand infrastructure.",
   "start": 1.329,
   "end": 3.369,
   "wordStart": 0,
   "wordEnd": 2
  },
  {
   "text": "That is worth more than you think.",
   "start": 4.169,
   "end": 5.869,
   "wordStart": 3,
   "wordEnd": 9
  },
  {
   "text": "The gap between idea and built has closed.",
   "start": 6.73,
   "end": 9.949,
   "wordStart": 10,
   "wordEnd": 17
  },
  {
   "text": "You do not have to quit tomorrow.",
   "start": 10.969,
   "end": 12.59,
   "wordStart": 18,
   "wordEnd": 24
  },
  {
   "text": "Start something small on the side.",
   "start": 13.289,
   "end": 15.25,
   "wordStart": 25,
   "wordEnd": 30
  },
  {
   "text": "A tool. A service. A name people trust.",
   "start": 15.909,
   "end": 19.889,
   "wordStart": 31,
   "wordEnd": 38
  },
  {
   "text": "Ownership is the goal.",
   "start": 20.949,
   "end": 22.469,
   "wordStart": 39,
   "wordEnd": 42
  },
  {
   "text": "Not employment.",
   "start": 22.949,
   "end": 23.93,
   "wordStart": 43,
   "wordEnd": 44
  },
  {
   "text": "Build something that works when you leave the room.",
   "start": 24.769,
   "end": 27.309,
   "wordStart": 45,
   "wordEnd": 53
  },
  {
   "text": "That is the beginning of a plan.",
   "start": 28.17,
