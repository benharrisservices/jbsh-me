 "lines": [
  {
   "text": "You understand infrastructure.",
   "start": 0.579,
   "end": 2.619,
   "wordStart": 0,
   "wordEnd": 2
  },
  {
   "text": "That is worth more than you think.",
   "start": 3.419,
   "end": 5.119,
   "wordStart": 3,
   "wordEnd": 9
  },
  {
   "text": "The gap between idea and built has closed.",
   "start": 5.98,
   "end": 9.199,
   "wordStart": 10,
   "wordEnd": 17
  },
  {
   "text": "You do not have to quit tomorrow.",
   "start": 10.219,
   "end": 11.84,
   "wordStart": 18,
   "wordEnd": 24
  },
  {
   "text": "Start something small on the side.",
   "start": 12.539,
   "end": 14.5,
   "wordStart": 25,
   "wordEnd": 30
  },
  {
   "text": "A tool. A service. A name people trust.",
   "start": 15.159,
   "end": 19.139,
   "wordStart": 31,
   "wordEnd": 38
  },
  {
   "text": "Ownership is the goal.",
   "start": 20.199,
   "end": 21.719,
   "wordStart": 39,
   "wordEnd": 42
  },
  {
   "text": "Not employment.",
   "start": 22.199,
   "end": 23.18,
   "wordStart": 43,
   "wordEnd": 44
  },
  {
   "text": "Build something that works when you leave the room.",
   "start": 24.019,
   "end": 26.559,
   "wordStart": 45,
   "wordEnd": 53
  },
  {
   "text": "That is the beginning of a plan.",
   "start": 27.42,
   "end": 29.182,
