 "lines": [
  {
   "text": "Hello James.",
   "start": 0.019,
   "end": 0.699,
   "wordStart": 0,
   "wordEnd": 1
  },
  {
   "text": "If you're seeing this,",
   "start": 1.539,
   "end": 2.379,
   "wordStart": 2,
   "wordEnd": 5
  },
  {
   "text": "your brother believes something about you.",
   "start": 2.539,
   "end": 4.199,
   "wordStart": 6,
   "wordEnd": 11
  },
  {
   "text": "That you were never meant for an ordinary life.",
   "start": 4.759,
   "end": 6.679,
   "wordStart": 12,
   "wordEnd": 20
  },
  {
   "text": "This is not really a website.",
   "start": 7.519,
   "end": 9.139,
   "wordStart": 21,
   "wordEnd": 26
  },
  {
   "text": "It's a gift.",
   "start": 9.679,
   "end": 10.359,
   "wordStart": 27,
   "wordEnd": 29
  },
  {
   "text": "A few keys.",
   "start": 11.019,
   "end": 11.939,
   "wordStart": 30,
   "wordEnd": 32
  },
  {
   "text": "A few ideas.",
   "start": 12.199,
   "end": 13.119,
   "wordStart": 33,
   "wordEnd": 35
  },
  {
   "text": "A reminder that the future belongs to people willing to build it.",
   "start": 13.84,
   "end": 16.939,
   "wordStart": 36,
   "wordEnd": 47
  },
  {
   "text": "Welcome.",
   "start": 18.0,
   "end": 18.364,
   "wordStart": 48,
   "wordEnd": 48
  }
