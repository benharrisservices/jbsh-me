 "lines": [
  {
   "text": "Hello James.",
   "start": 1.369,
   "end": 2.049,
   "wordStart": 0,
   "wordEnd": 1
  },
  {
   "text": "If you're seeing this,",
   "start": 2.889,
   "end": 3.729,
   "wordStart": 2,
   "wordEnd": 5
  },
  {
   "text": "your brother believes something about you.",
   "start": 3.889,
   "end": 5.549,
   "wordStart": 6,
   "wordEnd": 11
  },
  {
   "text": "That you were never meant for an ordinary life.",
   "start": 6.109,
   "end": 8.029,
   "wordStart": 12,
   "wordEnd": 20
  },
  {
   "text": "This is not really a website.",
   "start": 8.869,
   "end": 10.489,
   "wordStart": 21,
   "wordEnd": 26
  },
  {
   "text": "It's a gift.",
   "start": 11.029,
   "end": 11.709,
   "wordStart": 27,
   "wordEnd": 29
  },
  {
   "text": "A few keys.",
   "start": 12.369,
   "end": 13.289,
   "wordStart": 30,
   "wordEnd": 32
  },
  {
   "text": "A few ideas.",
   "start": 13.549,
   "end": 14.469,
   "wordStart": 33,
   "wordEnd": 35
  },
  {
   "text": "A reminder that the future belongs to people willing to build it.",
   "start": 15.19,
   "end": 18.289,
   "wordStart": 36,
   "wordEnd": 47
  },
  {
   "text": "Welcome.",
