 "lines": [
  {
   "text": "Hello James.",
   "start": 0.619,
   "end": 1.299,
   "wordStart": 0,
   "wordEnd": 1
  },
  {
   "text": "If you're seeing this,",
   "start": 2.139,
   "end": 2.979,
   "wordStart": 2,
   "wordEnd": 5
  },
  {
   "text": "your brother believes something about you.",
   "start": 3.139,
   "end": 4.799,
   "wordStart": 6,
   "wordEnd": 11
  },
  {
   "text": "That you were never meant for an ordinary life.",
   "start": 5.359,
   "end": 7.279,
   "wordStart": 12,
   "wordEnd": 20
  },
  {
   "text": "This is not really a website.",
   "start": 8.119,
   "end": 9.739,
   "wordStart": 21,
   "wordEnd": 26
  },
  {
   "text": "It's a gift.",
   "start": 10.279,
   "end": 10.959,
   "wordStart": 27,
   "wordEnd": 29
  },
  {
   "text": "A few keys.",
   "start": 11.619,
   "end": 12.539,
   "wordStart": 30,
   "wordEnd": 32
  },
  {
   "text": "A few ideas.",
   "start": 12.799,
   "end": 13.719,
   "wordStart": 33,
   "wordEnd": 35
  },
  {
   "text": "A reminder that the future belongs to people willing to build it.",
   "start": 14.44,
   "end": 17.539,
   "wordStart": 36,
   "wordEnd": 47
  },
  {
   "text": "Welcome.",
   "start": 18.6,
   "end": 18.964,
   "wordStart": 48,
   "wordEnd": 48
  }
