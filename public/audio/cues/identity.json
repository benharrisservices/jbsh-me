 "lines": [
  {
   "text": "You are not your job.",
   "start": 0.079,
   "end": 1.959,
   "wordStart": 0,
   "wordEnd": 4
  },
  {
   "text": "You are not your title.",
   "start": 2.819,
   "end": 4.0,
   "wordStart": 5,
   "wordEnd": 9
  },
  {
   "text": "You understand how things connect.",
   "start": 5.019,
