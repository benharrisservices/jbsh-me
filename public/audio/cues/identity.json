 "lines": [
  {
   "text": "You are not your job.",
   "start": 1.329,
   "end": 3.209,
   "wordStart": 0,
   "wordEnd": 4
  },
  {
   "text": "You are not your title.",
   "start": 4.069,
   "end": 5.25,
   "wordStart": 5,
   "wordEnd": 9
  },
  {
   "text": "You understand how things connect.",
   "start": 6.269,
   "end": 8.649,
   "wordStart": 10,
   "wordEnd": 14
  },
  {
   "text": "That is rarer than you think.",
   "start": 9.449,
   "end": 11.029,
   "wordStart": 15,
   "wordEnd": 20
  },
  {
   "text": "Most people use systems.",
   "start": 11.789,
   "end": 13.949,
   "wordStart": 21,
   "wordEnd": 24
  },
  {
   "text": "You see through them.",
   "start": 14.75,
   "end": 15.769,
   "wordStart": 25,
   "wordEnd": 28
  },
  {
   "text": "You were taught to wait for permission.",
   "start": 16.649,
   "end": 18.809,
   "wordStart": 29,
   "wordEnd": 35
  },
  {
   "text": "You do not need it.",
   "start": 19.609,
   "end": 20.469,
   "wordStart": 36,
   "wordEnd": 40
  },
  {
   "text": "The ones who build are not different.",
   "start": 21.449,
   "end": 23.85,
   "wordStart": 41,
   "wordEnd": 47
  },
  {
   "text": "They just started.",
