 "lines": [
  {
   "text": "You are not your job.",
   "start": 0.579,
   "end": 2.459,
   "wordStart": 0,
   "wordEnd": 4
  },
  {
   "text": "You are not your title.",
   "start": 3.319,
   "end": 4.5,
   "wordStart": 5,
   "wordEnd": 9
  },
  {
   "text": "You understand how things connect.",
   "start": 5.519,
   "end": 7.899,
   "wordStart": 10,
   "wordEnd": 14
  },
  {
   "text": "That is rarer than you think.",
   "start": 8.699,
   "end": 10.279,
   "wordStart": 15,
   "wordEnd": 20
  },
  {
   "text": "Most people use systems.",
   "start": 11.039,
   "end": 13.199,
   "wordStart": 21,
   "wordEnd": 24
  },
  {
   "text": "You see through them.",
   "start": 14.0,
   "end": 15.019,
   "wordStart": 25,
   "wordEnd": 28
  },
  {
   "text": "You were taught to wait for permission.",
   "start": 15.899,
   "end": 18.059,
   "wordStart": 29,
   "wordEnd": 35
  },
  {
   "text": "You do not need it.",
   "start": 18.859,
   "end": 19.719,
   "wordStart": 36,
   "wordEnd": 40
  },
  {
   "text": "The ones who build are not different.",
   "start": 20.699,
