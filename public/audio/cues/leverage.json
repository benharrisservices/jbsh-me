 "lines": [
  {
   "text": "Hard work is necessary.",
   "start": 1.309,
   "end": 3.029,
   "wordStart": 0,
   "wordEnd": 3
  },
  {
   "text": "It is not enough.",
   "start": 3.529,
   "end": 4.449,
   "wordStart": 4,
   "wordEnd": 7
  },
  {
   "text": "There are four kinds of leverage.",
   "start": 5.529,
   "end": 7.529,
   "wordStart": 8,
   "wordEnd": 13
  },
  {
   "text": "People. Money. Code. Words.",
   "start": 8.25,
   "end": 12.309,
   "wordStart": 14,
   "wordEnd": 17
  },
  {
   "text": "Two of them cost you nothing to start.",
   "start": 13.429,
   "end": 15.229,
   "wordStart": 18,
   "wordEnd": 25
  },
  {
   "text": "Code works while you sleep.",
   "start": 15.929,
   "end": 17.309,
   "wordStart": 26,
   "wordEnd": 30
  },
  {
   "text": "Words travel while you rest.",
   "start": 17.909,
   "end": 19.989,
   "wordStart": 31,
   "wordEnd": 35
  },
  {
   "text": "Build things that work without you.",
   "start": 21.069,
   "end": 22.969,
   "wordStart": 36,
   "wordEnd": 41
  },
  {
   "text": "Write things that teach without you.",
