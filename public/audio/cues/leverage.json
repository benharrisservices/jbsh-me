 "lines": [
  {
   "text": "Hard work is necessary.",
   "start": 0.059,
   "end": 1.779,
   "wordStart": 0,
   "wordEnd": 3
  },
  {
   "text": "It is not enough.",
   "start": 2.279,
   "end": 3.199,
   "wordStart": 4,
   "wordEnd": 7
  },
  {
   "text": "There are four kinds of leverage.",
   "start": 4.279,
   "end": 6.279,
   "wordStart": 8,
   "wordEnd": 13
  },
  {
   "text": "People. Money. Code. Words.",
   "start": 7.0,
   "end": 11.059,
   "wordStart": 14,
   "wordEnd": 17
  },
  {
   "text": "Two of them cost you nothing to start.",
   "start": 12.179,
   "end": 13.979,
   "wordStart": 18,
   "wordEnd": 25
  },
  {
   "text": "Code works while you sleep.",
   "start": 14.679,
   "end": 16.059,
   "wordStart": 26,
   "wordEnd": 30
  },
  {
   "text": "Words travel while you rest.",
   "start": 16.659,
   "end": 18.739,
   "wordStart": 31,
   "wordEnd": 35
  },
  {
   "text": "Build things that work without you.",
   "start": 19.819,
   "end": 21.719,
   "wordStart": 36,
   "wordEnd": 41
  },
  {
   "text": "Write things that teach without you.",
   "start": 22.479,
   "end": 24.921,
   "wordStart": 42,
   "wordEnd": 47
  }
 ]
