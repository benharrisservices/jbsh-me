 "lines": [
  {
   "text": "Hard work is necessary.",
   "start": 0.559,
   "end": 2.279,
   "wordStart": 0,
   "wordEnd": 3
  },
  {
   "text": "It is not enough.",
   "start": 2.779,
   "end": 3.699,
   "wordStart": 4,
   "wordEnd": 7
  },
  {
   "text": "There are four kinds of leverage.",
   "start": 4.779,
   "end": 6.779,
   "wordStart": 8,
   "wordEnd": 13
  },
  {
   "text": "People. Money. Code. Words.",
   "start": 7.5,
   "end": 11.559,
   "wordStart": 14,
   "wordEnd": 17
  },
  {
   "text": "Two of them cost you nothing to start.",
   "start": 12.679,
   "end": 14.479,
   "wordStart": 18,
   "wordEnd": 25
  },
  {
   "text": "Code works while you sleep.",
   "start": 15.179,
   "end": 16.559,
   "wordStart": 26,
   "wordEnd": 30
  },
  {
   "text": "Words travel while you rest.",
   "start": 17.159,
   "end": 19.239,
   "wordStart": 31,
   "wordEnd": 35
  },
  {
   "text": "Build things that work without you.",
   "start": 20.319,
   "end": 22.219,
   "wordStart": 36,
   "wordEnd": 41
  },
  {
   "text": "Write things that teach without you.",
