   "wordStart": 24,
   "wordEnd": 24
  },
  {
   "text": "Lift something heavy.",
   "start": 12.38,
   "end": 13.38,
   "wordStart": 25,
   "wordEnd": 27
  },
  {
   "text": "Eat real food.",
   "start": 14.119,
   "end": 15.279,
   "wordStart": 28,
   "wordEnd": 30
  },
  {
   "text": "Guard your sleep.",
   "start": 16.159,
   "end": 17.339,
   "wordStart": 31,
   "wordEnd": 33
  },
  {
   "text": "Everything runs on rest.",
   "start": 18.359,
   "end": 19.859,
   "wordStart": 34,
   "wordEnd": 37
  },
  {
