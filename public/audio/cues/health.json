 "lines": [
  {
   "text": "You cannot build from a body that is failing.",
   "start": 0.619,
   "end": 3.099,
   "wordStart": 0,
   "wordEnd": 8
  },
  {
   "text": "Health compounds both ways.",
   "start": 4.0,
   "end": 5.88,
   "wordStart": 9,
   "wordEnd": 12
  },
  {
   "text": "You do not need to be an athlete.",
