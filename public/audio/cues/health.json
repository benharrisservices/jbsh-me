   "wordStart": 25,
   "wordEnd": 27
  },
  {
   "text": "Eat real food.",
   "start": 13.619,
   "end": 14.779,
   "wordStart": 28,
   "wordEnd": 30
  },
  {
   "text": "Guard your sleep.",
   "start": 15.659,
