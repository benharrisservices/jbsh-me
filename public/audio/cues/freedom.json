 "lines": [
  {
   "text": "Freedom is not a yacht.",
   "start": 0.019,
   "end": 2.059,
   "wordStart": 0,
   "wordEnd": 4
  },
  {
   "text": "It is not a postcode.",
   "start": 2.919,
   "end": 4.159,
   "wordStart": 5,
   "wordEnd": 9
  },
  {
   "text": "It is your time belonging to you.",
   "start": 5.019,
   "end": 8.3,
   "wordStart": 10,
   "wordEnd": 16
  },
  {
   "text": "Comfort is not the same thing.",
   "start": 9.46,
   "end": 11.38,
   "wordStart": 17,
   "wordEnd": 22
  },
  {
   "text": "A salary feels safe.",
   "start": 12.079,
   "end": 13.819,
   "wordStart": 23,
   "wordEnd": 26
  },
  {
   "text": "Safe is not free.",
   "start": 14.739,
   "end": 16.84,
   "wordStart": 27,
   "wordEnd": 30
  },
  {
   "text": "You do not need to leave the country.",
   "start": 17.84,
   "end": 19.799,
   "wordStart": 31,
   "wordEnd": 38
  },
  {
   "text": "You need skills that travel.",
   "start": 20.439,
   "end": 22.299,
   "wordStart": 39,
   "wordEnd": 43
  },
  {
   "text": "Savings that buy choices.",
   "start": 23.1,
   "end": 25.239,
   "wordStart": 44,
   "wordEnd": 47
  },
  {
   "text": "Income that does not depend on one door.",
   "start": 26.079,
   "end": 29.159,
   "wordStart": 48,
   "wordEnd": 55
  },
  {
   "text": "Freedom is built slowly.",
   "start": 30.239,
   "end": 32.119,
   "wordStart": 56,
   "wordEnd": 59
  },
  {
   "text": "Skill by skill.",
   "start": 32.719,
   "end": 34.0,
   "wordStart": 60,
   "wordEnd": 62
  },
  {
   "text": "You are already facing the right way.",
   "start": 34.88,
   "end": 37.59,
   "wordStart": 63,
   "wordEnd": 69
  }
 ]
