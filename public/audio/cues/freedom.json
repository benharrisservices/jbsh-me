 "lines": [
  {
   "text": "Freedom is not a yacht.",
   "start": 0.519,
   "end": 2.559,
   "wordStart": 0,
   "wordEnd": 4
  },
  {
   "text": "It is not a postcode.",
   "start": 3.419,
   "end": 4.659,
   "wordStart": 5,
   "wordEnd": 9
  },
  {
   "text": "It is your time belonging to you.",
   "start": 5.519,
   "end": 8.8,
   "wordStart": 10,
   "wordEnd": 16
  },
  {
   "text": "Comfort is not the same thing.",
   "start": 9.96,
   "end": 11.88,
   "wordStart": 17,
   "wordEnd": 22
  },
  {
   "text": "A salary feels safe.",
   "start": 12.579,
   "end": 14.319,
   "wordStart": 23,
   "wordEnd": 26
  },
  {
   "text": "Safe is not free.",
   "start": 15.239,
   "end": 17.34,
   "wordStart": 27,
   "wordEnd": 30
  },
  {
   "text": "You do not need to leave the country.",
   "start": 18.34,
   "end": 20.299,
   "wordStart": 31,
   "wordEnd": 38
  },
  {
   "text": "You need skills that travel.",
   "start": 20.939,
   "end": 22.799,
   "wordStart": 39,
   "wordEnd": 43
  },
  {
   "text": "Savings that buy choices.",
   "start": 23.6,
   "end": 25.739,
   "wordStart": 44,
   "wordEnd": 47
  },
  {
   "text": "Income that does not depend on one door.",
   "start": 26.579,
   "end": 29.659,
   "wordStart": 48,
   "wordEnd": 55
  },
  {
   "text": "Freedom is built slowly.",
   "start": 30.739,
   "end": 32.619,
   "wordStart": 56,
   "wordEnd": 59
  },
  {
   "text": "Skill by skill.",
   "start": 33.219,
   "end": 34.5,
   "wordStart": 60,
   "wordEnd": 62
  },
  {
   "text": "You are already facing the right way.",
   "start": 35.38,
   "end": 38.09,
   "wordStart": 63,
   "wordEnd": 69
  }
 ],
