 "lines": [
  {
   "text": "Freedom is not a yacht.",
   "start": 1.269,
   "end": 3.309,
   "wordStart": 0,
   "wordEnd": 4
  },
  {
   "text": "It is not a postcode.",
   "start": 4.169,
   "end": 5.409,
   "wordStart": 5,
   "wordEnd": 9
  },
  {
   "text": "It is your time belonging to you.",
   "start": 6.269,
   "end": 9.55,
   "wordStart": 10,
   "wordEnd": 16
  },
  {
   "text": "Comfort is not the same thing.",
   "start": 10.71,
   "end": 12.63,
   "wordStart": 17,
   "wordEnd": 22
  },
  {
   "text": "A salary feels safe.",
   "start": 13.329,
   "end": 15.069,
   "wordStart": 23,
   "wordEnd": 26
  },
  {
   "text": "Safe is not free.",
   "start": 15.989,
   "end": 18.09,
   "wordStart": 27,
   "wordEnd": 30
  },
  {
   "text": "You do not need to leave the country.",
   "start": 19.09,
   "end": 21.049,
   "wordStart": 31,
   "wordEnd": 38
  },
  {
   "text": "You need skills that travel.",
   "start": 21.689,
   "end": 23.549,
   "wordStart": 39,
   "wordEnd": 43
  },
  {
   "text": "Savings that buy choices.",
   "start": 24.35,
   "end": 26.489,
   "wordStart": 44,
   "wordEnd": 47
  },
  {
   "text": "Income that does not depend on one door.",
   "start": 27.329,
   "end": 30.409,
   "wordStart": 48,
   "wordEnd": 55
  },
  {
   "text": "Freedom is built slowly.",
   "start": 31.489,
   "end": 33.369,
   "wordStart": 56,
   "wordEnd": 59
  },
  {
   "text": "Skill by skill.",
   "start": 33.969,
   "end": 35.25,
   "wordStart": 60,
   "wordEnd": 62
  },
  {
   "text": "You are already facing the right way.",
   "start": 36.13,
   "end": 38.84,
   "wordStart": 63,
   "wordEnd": 69
  }
 ],
